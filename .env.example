# ── App ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000

# ── Database (MySQL via Prisma) ───────────────────────────
# BE1 owns migrations — pull schema changes from `develop` before running prisma:generate
DATABASE_URL="mysql://root:password@localhost:3306/fintech_platform"

# ── Redis (idempotency locks, BullMQ queues, rolling success-rate counters) ──
REDIS_URL="redis://localhost:6379"

# ── Auth / JWT (BE1-owned, needed by all modules for RBAC middleware) ────
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── BE2: Transfer Switch / NIP ────────────────────────────
NIBSS_BASE_URL=https://sandbox.nibss-plc.com.ng
NIBSS_API_KEY=
NIBSS_CLIENT_ID=
BANK_DIRECT_API_BASE_URL=
BANK_DIRECT_API_KEY=
TRANSFER_ROUTE_WINDOW_MINUTES=5
AUTO_REVERSAL_TIMEOUT_MINUTES=10

# ── BE2: Dynamic Virtual Accounts ─────────────────────────
WEMA_DVA_BASE_URL=
WEMA_DVA_API_KEY=
PROVIDUS_DVA_BASE_URL=
PROVIDUS_DVA_API_KEY=
STERLING_DVA_BASE_URL=
STERLING_DVA_API_KEY=
DVA_WEBHOOK_SECRET=changeme_webhook_secret

# ── BE2: VAS / Bills Aggregation ──────────────────────────
BAXI_BASE_URL=
BAXI_API_KEY=
CORALPAY_BASE_URL=
CORALPAY_API_KEY=
INTERSWITCH_BASE_URL=
INTERSWITCH_API_KEY=
VAS_AGGREGATOR_TIMEOUT_MS=1500

# ── BE2: Smart POS / TMS ──────────────────────────────────
TMS_ISO8583_PORT=9500
TMS_TERMINAL_SHARED_SECRET=changeme_tms_secret

# ── BE2: Compliance Exporters ──────────────────────────────
NFIU_EXPORT_DIR=./exports/nfiu
CBN_EXPORT_DIR=./exports/cbn
FIRS_EXPORT_DIR=./exports/firs

# ── BE1: KYC / Identity (shared reference, BE1-owned) ─────
BVN_NIBSS_API_KEY=
NIN_NIMC_API_KEY=
CAC_API_KEY=
PEP_SCREENING_API_KEY=